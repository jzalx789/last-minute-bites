{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "last-minute-bites-demo",
  "main": "./worker.js",
  "compatibility_date": "2026-09-15",
  "assets": {
    "directory": "../static",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/healthz"],
  },
  "triggers": {"crons": ["*/5 * * * *"]},
  "vars": {"PUBLIC_ORIGIN": "https://last-minute-bites-demo.jzalx789.workers.dev"},
  "durable_objects": {
    "bindings": [{ "name": "KITCHENS", "class_name": "KitchenStore" }],
  },
  "services": [
    {
      "binding": "FOOD_AI",
      "service": "caresync-is3542-demo",
      "entrypoint": "FoodAI",
    },
  ],
  "migrations": [
    { "tag": "kitchen-v1", "new_sqlite_classes": ["KitchenStore"] },
  ],
}
