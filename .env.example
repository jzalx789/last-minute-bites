# Optional non-secret settings. Not auto-loaded: export these in your shell/service.
LMB_HOST=127.0.0.1
LMB_PORT=8000
LMB_DB=.data/kitchen.sqlite3
# Only when running behind a correctly configured HTTPS reverse proxy:
# LMB_SECURE_COOKIE=1
# LMB_ORIGIN=https://your-app.example
# Optional browser-test executable path (not needed by the application):
# LMB_TEST_CHROMIUM=/usr/bin/chromium
# No external API key is required. Photo recognition is not implemented.
